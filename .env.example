# Re:Trip AI — environment variables
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.

# --- Firebase (client SDK) ---------------------------------------------------
# These are shipped to the browser. They are project identifiers, not secrets,
# but access must still be restricted via Firestore Security Rules (later phase).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase (Admin SDK, server only) -------------------------------------
# Full service-account JSON as a single-line string. Server-only. Do NOT prefix
# with NEXT_PUBLIC_. Do NOT commit the JSON file.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Server-side external API keys (server only) ---------------------------
# Not exposed to the browser. Called only from Route Handlers under app/api/*.
TOUR_API_KEY=
WEATHER_API_KEY=
KAKAO_API_KEY=
LLM_API_KEY=
